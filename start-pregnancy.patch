+@login_required
+def start_pregnancy(request):
+    """Onboarding step: a mother enters her LMP and we create her PregnancyProfile."""
+    if request.user.role != 'Mother':
+        messages.warning(request, "Only mothers can start a pregnancy profile.")
+        return redirect('home:dashboard')
+
+    mother = get_object_or_404(MotherProfile, user=request.user)
+
+    if PregnancyProfile.objects.filter(mother=mother, pregnancy_status='Ongoing').exists():
+        messages.info(request, "You already have an active pregnancy profile.")
+        return redirect('home:dashboard')
+
+    if request.method == 'POST':
+        form = StartPregnancyForm(request.POST)
+        if form.is_valid():
+            lmp = form.cleaned_data['lmp_date']
+            edd = calculate_edd(lmp)
+
+            # Lock the mother row so a double-click can't create two ongoing pregnancies.
+            with transaction.atomic():
+                MotherProfile.objects.select_for_update().get(pk=mother.pk)
+                if PregnancyProfile.objects.filter(mother=mother, pregnancy_status='Ongoing').exists():
+                    return redirect('home:dashboard')
+                PregnancyProfile.objects.create(
+                    mother=mother,
+                    lmp_date=lmp,
+                    edd_date=edd,
+                    pregnancy_status='Ongoing',
+                )
+
+            messages.success(request, f"Your pregnancy journey has begun. Estimated due date: {edd:%B %d, %Y}.")
+            return redirect('home:dashboard')
+    else:
+        form = StartPregnancyForm()
+
+    return render(request, 'profile/start_pregnancy.html', {'form': form})
+
+
