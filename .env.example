# .env is git-ignored: never commit it or share it.

# --- Django ---
# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Keep the single quotes around it.
SECRET_KEY='paste-your-generated-key-here'
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Only needed when deployed, e.g. https://maternilink.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database (Supabase, Session pooler) ---
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# --- AI assistant (optional) ---
# Leave empty to use the built-in FAQ only.
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-haiku-5-5